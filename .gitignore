# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/

# Test tooling artifacts (the tests themselves ARE committed, just not these)
.pytest_cache/
.coverage
htmlcov/

# Runtime data (SQLite DB is mutated on every run, not source)
data/*.db
data/*.sqlite3

# Logs
*.log
app.log

# Generated project output (created by the factory/codegen tool)
workspace/projects/*

# Env / secrets
.env
.env.*

# Bootstrap-generated secrets (see the `auth` section of config.yaml)
auth/*-password
auth/*-secret

# Editor / IDE
.vscode/
.idea/
*.swp

# OS cruft
.DS_Store
Thumbs.db