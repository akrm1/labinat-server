FROM python:3.12-slim

WORKDIR /app

# The emitted factory tree is the build context, so main.py and the
# {{ app.name | snake }} package are copied in as-is.
COPY . .

RUN pip install --no-cache-dir fastapi "uvicorn[standard]"

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
