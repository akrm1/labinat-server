{
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "description": {
            "type": "string",
            "description": "The description of the factory"
        },
        "config": {
            "type": "object",
            "description": "The config schema for this factory's slice of the project config",
            "properties": {
                "properties": {
                    "type": "object"
                },
                "required": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            }
        },
        "maps": {
            "type": "object",
            "description": "Maps definitions used by frames"
        },
        "pipelines": {
            "type": "object",
            "description": "Optional named shell pipelines. Omit any pipeline a factory does not need.",
            "additionalProperties": false,
            "properties": {
                "init": {
                    "type": "array",
                    "description": "After project clone, before emitting/building blocks",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": { "type": "string" },
                            "cmd":  { "type": "string" }
                        },
                        "required": ["name", "cmd"]
                    }
                },
                "build": {
                    "type": "array",
                    "description": "After project and blocks are fully emitted",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": { "type": "string" },
                            "cmd":  { "type": "string" }
                        },
                        "required": ["name", "cmd"]
                    }
                },
                "run": {
                    "type": "array",
                    "description": "Run the application for experience and testing",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": { "type": "string" },
                            "cmd":  { "type": "string" }
                        },
                        "required": ["name", "cmd"]
                    }
                },
                "debug": {
                    "type": "array",
                    "description": "Run the application in debug mode",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": { "type": "string" },
                            "cmd":  { "type": "string" }
                        },
                        "required": ["name", "cmd"]
                    }
                }
            }
        }
    }
}
