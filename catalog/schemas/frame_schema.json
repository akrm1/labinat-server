{
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "The name of the frame"
        },
        "factory": {
            "type": "string",
            "description": "The factory of the frame"
        },
        "concretes": {
            "type": "array",
            "description": "The concretes of the frame",
            "items": {
                "type": "object",
                "description": "The concrete object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "The base name of the concrete, without extension (e.g. 'model'). Must match a template file 'concretes/<name>.<extension>.j2' (or '.<extension>' if not a template)."
                    },
                    "extension": {
                        "type": "string",
                        "description": "The output file extension, without the leading dot (e.g. 'py')"
                    },
                    "destination": {
                        "type": "string",
                        "description": "The directory (relative to src/<factory>) where the rendered concrete is written"
                    }
                },
                "required": ["name", "extension", "destination"]
            }
        },
        "description": {
            "type": "string",
            "description": "The description of the frame"
        },
        "properties": {
            "type": "object",
            "description": "The properties of the frame",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "description": "The type of the property"
                    }
                },
                "required": ["type"]
            }
        },
        "required": {
            "type": "array",
            "description": "The required properties of the frame",
            "items": {
                "type": "string",
                "description": "The name of the required property"
            }
        }
    },
    "required": ["name", "factory", "concretes", "description", "properties"]
}